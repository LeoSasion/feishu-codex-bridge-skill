{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openai.local/feishu-codex-bridge/external-p3-soak-evidence-v1.schema.json",
  "title": "Feishu Codex Bridge external P3 bounded soak evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_kind",
    "receipt_id",
    "created_at_utc",
    "source_version",
    "source_manifest_sha256",
    "p0_evidence",
    "execution",
    "guards",
    "immutability"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "evidence_kind": { "const": "external_p3_bounded_soak" },
    "receipt_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
    },
    "created_at_utc": { "type": "string", "format": "date-time" },
    "source_version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "source_manifest_sha256": { "$ref": "#/$defs/sha256" },
    "p0_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "sha256", "validation_status"],
      "properties": {
        "file": {
          "type": "string",
          "pattern": "^p0b-v1-[a-f0-9-]{36}\\.json$"
        },
        "sha256": { "$ref": "#/$defs/sha256" },
        "validation_status": { "const": "pass" }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "working_directory",
        "iterations",
        "scenario_count",
        "total_tests_run",
        "hard_timeout_seconds",
        "started_at_utc",
        "finished_at_utc",
        "duration_seconds",
        "runner_status",
        "timed_out",
        "child_process_policy",
        "child_process_attempts",
        "live_desktop_contacted",
        "live_feishu_contacted",
        "result_sha256",
        "stdout_sha256",
        "stderr_sha256",
        "runner_nonce_sha256"
      ],
      "properties": {
        "working_directory": { "type": "string", "minLength": 3 },
        "iterations": { "type": "integer", "minimum": 1, "maximum": 100 },
        "scenario_count": { "const": 10 },
        "total_tests_run": { "type": "integer", "minimum": 10, "maximum": 1000 },
        "hard_timeout_seconds": { "type": "integer", "minimum": 30, "maximum": 900 },
        "started_at_utc": { "type": "string", "format": "date-time" },
        "finished_at_utc": { "type": "string", "format": "date-time" },
        "duration_seconds": { "type": "number", "minimum": 0, "exclusiveMaximum": 900 },
        "runner_status": { "const": "pass" },
        "timed_out": { "const": false },
        "child_process_policy": { "const": "forbidden" },
        "child_process_attempts": { "const": 0 },
        "live_desktop_contacted": { "const": false },
        "live_feishu_contacted": { "const": false },
        "result_sha256": { "$ref": "#/$defs/sha256" },
        "stdout_sha256": { "$ref": "#/$defs/sha256" },
        "stderr_sha256": { "$ref": "#/$defs/sha256" },
        "runner_nonce_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "guards": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "listener_stopped",
        "runner_surface",
        "process_ancestry_depth",
        "process_ancestry_complete",
        "process_ancestry_termination",
        "codex_ancestor_match_count",
        "p0_pre_validated",
        "p0_post_validated",
        "source_snapshot_reused",
        "snapshot_files_pinned",
        "snapshot_file_count",
        "source_unchanged",
        "job_object_enforced"
      ],
      "properties": {
        "listener_stopped": { "const": true },
        "runner_surface": { "enum": ["external_terminal", "ci"] },
        "process_ancestry_depth": { "type": "integer", "minimum": 2, "maximum": 64 },
        "process_ancestry_complete": { "type": "boolean" },
        "process_ancestry_termination": {
          "enum": ["process_tree_root", "exited_ancestor"]
        },
        "codex_ancestor_match_count": { "const": 0 },
        "p0_pre_validated": { "const": true },
        "p0_post_validated": { "const": true },
        "source_snapshot_reused": { "const": true },
        "snapshot_files_pinned": { "const": true },
        "snapshot_file_count": { "type": "integer", "minimum": 1 },
        "source_unchanged": { "const": true },
        "job_object_enforced": { "const": true }
      }
    },
    "immutability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "write_mode",
        "destination_preexisted",
        "evidence_outside_source",
        "overwrite_attempted"
      ],
      "properties": {
        "write_mode": { "const": "create_new" },
        "destination_preexisted": { "const": false },
        "evidence_outside_source": { "const": true },
        "overwrite_attempted": { "const": false }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
