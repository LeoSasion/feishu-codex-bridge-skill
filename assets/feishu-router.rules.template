# Project-local allow rules for the single-task Feishu Desktop Gateway queue.
# Render absolute Windows paths with every backslash escaped as `\\`.
# Codex loads these rules only after a separately approved restart and only
# when the project layer is trusted.
#
# Deliberately omit `register`, `status`, every other script, and every process
# lifecycle command. Registration/replacement remains a fresh approval action.
# These rules fix only the executable, helper, runtime, and subcommand prefixes.
# The examples are not blanket authorization for arbitrary trailing IDs or
# fences; `router_queue.py` must still validate registration, wake generation,
# request identity, and fencing tokens at runtime.

prefix_rule(
    pattern = [
        "{{PYTHON_RULE_PATH}}",
        "{{ROUTER_QUEUE_RULE_PATH}}",
        "--runtime-dir",
        "{{RUNTIME_DIR_RULE_PATH}}",
        "sentinel-probe",
    ],
    decision = "allow",
    justification = "Allow the metadata-only Feishu Desktop Gateway probe for this fixed project runtime.",
    match = [
        '\"{{PYTHON_RULE_PATH}}\" \"{{ROUTER_QUEUE_RULE_PATH}}\" --runtime-dir \"{{RUNTIME_DIR_RULE_PATH}}\" sentinel-probe --router-thread-id canary --host-id local',
    ],
    not_match = [
        '\"{{PYTHON_RULE_PATH}}\" \"{{ROUTER_QUEUE_RULE_PATH}}\" --runtime-dir \"{{RUNTIME_DIR_RULE_PATH}}\" status',
        '\"{{PYTHON_RULE_PATH}}\" \"{{ROUTER_QUEUE_RULE_PATH}}\" --runtime-dir \"{{RUNTIME_DIR_RULE_PATH}}\" register',
    ],
)

